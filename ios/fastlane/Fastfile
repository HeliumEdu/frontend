
default_platform(:ios)

platform :ios do
  desc "Print the next available build number for a given version"
  lane :next_build_number do |options|
    version = options[:version]
    UI.user_error!("version is required") unless version

    bosun_next_build_number(api_key: connect_api_key, version: version, scope_to_version: true)
  end

  desc "Upload IPA to TestFlight and wait for App-Store-side processing"
  lane :deploy_testflight do |options|
    bosun_testflight_upload(
      api_key: connect_api_key,
      ipa: options[:ipa_path] || "../build/ios/ipa/Helium.ipa",
      build_number: options[:build_number],
      version: options[:version],
      skip_submission: true,
      wait_processing_timeout_duration: 1800,
      reraise_build_watcher: false,
      rejection_messages: ["This bundle is invalid", "is closed for new build submissions", "bundle version must be higher", "ATTRIBUTE.INVALID.DUPLICATE"],
      verify_by_version: true
    )
  end

  desc "Stage an App Store version with the given TestFlight build (CI uploads it), push metadata text every time and screenshots only when push_store_assets:true. Optionally auto-submit for App Review (an approved version releases automatically). The marketing app icon is part of the IPA and is not affected by this flag."
  lane :submit_appstore do |options|
    version = options[:version]
    build_number = options[:build_number]
    submit_for_review = options[:submit_for_review].to_s == "true"
    push_store_assets = options[:push_store_assets].to_s == "true"
    replace_pending_review = options[:replace_pending_review].to_s == "true"

    UI.user_error!("version is required") unless version
    UI.user_error!("build_number is required") unless build_number

    bosun_submit_app_store(
      api_key: connect_api_key,
      version: version,
      build_number: build_number,
      submit_for_review: submit_for_review,
      push_store_assets: push_store_assets,
      replace_waiting_for_review: replace_pending_review,
      automatic_release: true
    )
  end

  def connect_api_key
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8")
    )
  end
end
