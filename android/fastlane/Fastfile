# Fastfile for Android deployment

default_platform(:android)

platform :android do
  desc "Print the next available Play version code, taken across every track"
  lane :next_version_code do
    codes = %w[production beta alpha internal].flat_map do |track|
      begin
        google_play_track_version_codes(track: track)
      rescue StandardError => e
        # A track with no releases raises rather than returning empty.
        UI.message("No version codes on track '#{track}' (#{e.class})")
        []
      end
    end

    next_code = (codes.flatten.map(&:to_i).max || 0) + 1
    UI.message("Next version code: #{next_code}")
    next_code
  end

  desc "Upload an AAB to the Internal track. Every CI build lands here so testers run the newest code, and the release workflow stages its candidate the same way before promoting it to Production."
  lane :deploy_internal do |options|
    aab_path = options[:aab_path] || "../build/app/outputs/bundle/release/app-release.aab"
    version = options[:version]

    upload_to_play_store(
      aab: aab_path,
      track: 'internal',
      version_name: version,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: 'completed'
    )
  end

  desc "Re-create the Internal release for a version code whose bundle Play already holds. Every CI preview replaces the Internal release, so a deploy that runs later than its release (a re-deploy of latest, a specific version, a rollback) finds its candidate gone; this puts it back from Play's artifact library without re-uploading the AAB, which Play would reject as a duplicate version code."
  private_lane :ensure_staged_on_internal do |options|
    version = options[:version]
    version_code = options[:version_code].to_i

    staged_codes = google_play_track_version_codes(track: 'internal')
    if staged_codes.include?(version_code)
      UI.message("Version code #{version_code} is already on the Internal track")
      next
    end

    UI.important("Version code #{version_code} is no longer on the Internal track (found: #{staged_codes.inspect}); re-staging it from Play's artifact library")
    # supply's upload_to_play_store only writes a track when it has uploaded a
    # binary in the same run (version_codes_to_retain alone is a no-op since
    # fastlane 2.238), so drive its Play client directly with the same
    # tracks.update call it would otherwise make.
    #
    # Draft, not completed: Play refuses a completed rollout whose codes are
    # all lower than the track's current release, which is exactly the case
    # when a newer CI preview has landed. A draft is not a rollout, so it is
    # exempt, and it leaves the preview live for testers. Promotion accepts a
    # release of any status when filtered by version_code.
    #
    # Actions run from the project dir (fastlane chdirs up for each one) while
    # lane bodies run from fastlane/, so step up to match and let the Appfile's
    # relative json_key_file resolve the way it does for every action.
    require 'supply'
    Dir.chdir('..') do
      Supply.config = FastlaneCore::Configuration.create(Supply::Options.available_options, { track: 'internal' })
      client = Supply::Client.make_from_config
      client.begin_edit(package_name: Supply.config[:package_name])
      track = client.tracks('internal').first || AndroidPublisher::Track.new(track: 'internal')
      track.releases = [
        AndroidPublisher::TrackRelease.new(name: version, status: 'draft', version_codes: [version_code])
      ]
      client.update_track('internal', track)
      client.commit_current_edit!
    end
    UI.success("Re-staged #{version} (#{version_code}) on the Internal track as a draft")
  end

  desc "Promote the Internal-track release candidate to Production, pushing metadata text every time and store-listing assets only when push_store_assets:true. Re-stages the candidate on Internal first if a CI preview has since replaced it, so the lane is idempotent for a fresh release, a re-deploy, or a rollback. Leaves the release as a draft for the operator to send for review; set submit_for_review:true to send it from CI. Managed Publishing gates the post-review publish either way."
  lane :deploy_production do |options|
    version = options[:version]
    version_code = options[:version_code]
    # Fastlane CLI args arrive as strings; coerce to a real boolean.
    submit_for_review = options[:submit_for_review].to_s == "true"
    # Default false: icon + screenshots only re-upload when the operator
    # explicitly flips this on (e.g. after a marketing refresh). Re-pushing
    # unchanged assets every release wastes a store-listing review pass.
    push_store_assets = options[:push_store_assets].to_s == "true"

    UI.user_error!("version is required") unless version
    UI.user_error!("version_code is required") unless version_code

    # Play requires changelogs/<versionCode>.txt for every release. Generate
    # it from the canonical template — release notes rarely vary per build,
    # so we keep one source of truth and stamp each versionCode at deploy time.
    # Fastlane chdirs into fastlane/ before lane execution, so resolve from
    # there; expand to absolute so supply isn't sensitive to any later chdir.
    metadata_dir = File.expand_path("metadata/android")
    template = File.join(metadata_dir, "en-US/default_release_notes.txt")
    changelog_dir = File.join(metadata_dir, "en-US/changelogs")
    changelog = File.join(changelog_dir, "#{version_code}.txt")
    UI.user_error!("Missing #{template}") unless File.exist?(template)
    FileUtils.mkdir_p(changelog_dir)
    FileUtils.cp(template, changelog)

    ensure_staged_on_internal(version: version, version_code: version_code)

    # supply promotes only on a run that uploads no binary of its own, so both
    # skip flags are load-bearing. The promoted release keeps the name stamped
    # on the Internal release, which leaves version_name inert here;
    # version_code picks which Internal release carries over, and names the
    # changelog supply looks for.
    upload_to_play_store(
      metadata_path: metadata_dir,
      track: 'internal',
      track_promote_to: 'production',
      version_code: version_code,
      # Draft is the only way to reach Production without submitting: Play reviews this app
      # automatically and rejects changes_not_sent_for_review, so a 'completed' release is a
      # submitted one. 'completed' = auto-submit, then Managed Publishing holds for publish.
      track_promote_release_status: submit_for_review ? 'completed' : 'draft',
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: !push_store_assets,
      skip_upload_screenshots: !push_store_assets
    )

    assets_note = push_store_assets ? "with store-listing assets re-uploaded" : "with store-listing assets unchanged"
    if submit_for_review
      UI.success("Submitted #{version} (#{version_code}) to Production for review (#{assets_note}). Google's review is async; once approved Play will hold the release for a manual 'Publish' click in Play Console (Managed Publishing).")
    else
      UI.success("Staged #{version} (#{version_code}) on Production as a draft (#{assets_note}). Click 'Send for review' in Play Console when ready.")
    end
  end
end
