# Fastfile for Android deployment

default_platform(:android)

platform :android do
  desc "Print the next available Play version code, taken across every track"
  lane :next_version_code do
    bosun_next_version_code
  end

  desc "Upload an AAB to the Internal track. Every CI build lands here so testers run the newest code, and the release workflow stages its candidate the same way before promoting it to Production."
  lane :deploy_internal do |options|
    bosun_upload_to_play_internal(
      aab: options[:aab_path] || "../build/app/outputs/bundle/release/app-release.aab",
      version: options[:version]
    )
  end

  desc "Promote the Internal-track release candidate to Production, pushing metadata text every time and store-listing assets only when push_store_assets:true. Re-stages the candidate on Internal first if a CI preview has since replaced it, so the lane is idempotent for a fresh release, a re-deploy, or a rollback. Leaves the release as a draft for the operator to send for review; set submit_for_review:true to send it from CI. Managed Publishing gates the post-review publish either way."
  lane :submit_production do |options|
    version = options[:version]
    version_code = options[:version_code]
    UI.user_error!("version is required") unless version
    UI.user_error!("version_code is required") unless version_code

    bosun_submit_play_production(
      version: version,
      version_code: version_code,
      metadata_dir: File.expand_path("metadata/android"),
      submit_for_review: options[:submit_for_review].to_s == "true",
      push_store_assets: options[:push_store_assets].to_s == "true",
      replace_in_review: true
    )
  end
end
